{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/check-alerts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/macro?range=10y",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/crypto/market-collector?instId=BTC-USDT-SWAP",
      "schedule": "*/5 * * * *"
    }
  ]
}
